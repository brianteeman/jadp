{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "plg_system_jadp2",
  "version": "0.1.0",
  "description": "JADP2: Display Preferences and External Link",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "plg.system.jadp2",
      "type": "style",
      "uri": "plg_system_jadp2/jadp.css"
    },
    {
      "name": "plg.system.jadp2.skip",
      "type": "style",
      "uri": "plg_system_jadp2/jadp-skip.css"
    },
    {
      "name": "plg.system.jadp2.preferences",
      "type": "script",
      "uri": "plg_system_jadp2/jadp-preferences.js",
      "attributes": {
        "defer": false
      }
    },
    {
      "name": "plg.system.jadp2.init",
      "type": "script",
      "uri": "plg_system_jadp2/jadp-init.js",
      "dependencies": [
        "plg.system.jadp2.preferences"
      ],
      "attributes": {
        "defer": false
      }
    },
    {
      "name": "plg.system.jadp2.engine",
      "type": "script",
      "uri": "plg_system_jadp2/jadp.js",
      "dependencies": [
        "plg.system.jadp2.preferences"
      ],
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "plg.system.jadp2.host",
      "type": "script",
      "uri": "plg_system_jadp2/jadp-host.js",
      "dependencies": [
        "core"
      ],
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "plg.system.jadp2.ui",
      "type": "script",
      "uri": "plg_system_jadp2/jadp-ui.js",
      "dependencies": [
        "plg.system.jadp2.engine",
        "plg.system.jadp2.host"
      ],
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "plg.system.jadp2.ui",
      "type": "style",
      "uri": "plg_system_jadp2/jadp-ui.css"
    },
    {
      "name": "plg.system.jadp2.externallink",
      "type": "script",
      "uri": "plg_system_jadp2/jadp-externallink.js",
      "dependencies": [
        "core"
      ],
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "plg.system.jadp2.externallink",
      "type": "style",
      "uri": "plg_system_jadp2/jadp-externallink.css"
    }
  ]
}
