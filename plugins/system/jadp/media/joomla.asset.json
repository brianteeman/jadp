{
    "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
    "name": "plg_system_jadp",
    "version": "0.1.0",
    "description": "Joomla Accessibility Display Preferences",
    "license": "GPL-2.0-or-later",
    "assets": [
        {
            "name": "plg.system.jadp",
            "type": "style",
            "uri": "plg_system_jadp/jadp.css"
        },
        {
            "name": "plg.system.jadp.init",
            "type": "script",
            "uri": "plg_system_jadp/jadp-init.js",
            "attributes": {
                "defer": false
            }
        },
        {
            "name": "plg.system.jadp",
            "type": "script",
            "uri": "plg_system_jadp/jadp.js",
            "attributes": {
                "defer": true
            }
        },
        {
            "name": "plg.system.jadp.host",
            "type": "script",
            "uri": "plg_system_jadp/jadp-host.js",
            "dependencies": [
                "core"
            ],
            "attributes": {
                "defer": true
            }
        },
        {
            "name": "plg.system.jadp.ui",
            "type": "script",
            "uri": "plg_system_jadp/jadp-ui.js",
            "dependencies": [
                "plg.system.jadp",
                "plg.system.jadp.host"
            ],
            "attributes": {
                "defer": true
            }
        }
    ]
}
